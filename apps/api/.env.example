# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="mysql://root:password@localhost:3306/waifu_player_dev"
DATABASE_TEST_URL="mysql://root:password@localhost:3306/waifu_player_test"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Upload
UPLOAD_DIR="./uploads"
MAX_AUDIO_SIZE_MB=50
MAX_COVER_SIZE_MB=5

# CORS
CORS_ORIGIN="http://localhost:8081"
